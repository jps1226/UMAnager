# Build output
bin/
obj/

# Secrets — NEVER commit these
appsettings.json
appsettings.*.json
!appsettings.example.json
*.env
secrets.*

# Runtime state
.service-pids.json
logs/
*.log
build_output.txt

# JRA-VAN SDK artifacts (not redistributable — install JV-Link SDK separately)
JVData_Struct.cs
JVDTLab.IDL

# .NET
*.user
.vs/
*.suo

# Claude Code local state and project notes
.claude/
memory/

# All markdown — kept local-only (specs, logs, Q&A reference)
*.md
!README.md

# Browser HAR captures — may contain session cookies / auth tokens
*.har

# Local dev scratch — ad-hoc SQL queries, recap output, import tooling
q_*.sql
query.sql
recap_data.json
run-recap.ps1
import_days/

# KEIBrain — generated feature tables / model artifacts (regenerate via build_features.mjs)
KEIBrain/data/
